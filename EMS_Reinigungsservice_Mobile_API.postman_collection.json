      "type": "string"
    },
    {
      "key": "execution_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "location_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "complaint_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "onesignal_player_id",
      "value": "your-onesignal-player-id",
      "type": "string"
    },
    {
