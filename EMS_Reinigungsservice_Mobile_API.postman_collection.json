            "url": {
              "raw": "{{base_url}}/api/v1/complaints",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "complaints"
              ]
            },
            "description": "Creates the complaint as `pending`. The response `data.id` is the `{{complaint_id}}` used by Get Complaint Detail."
          }
        },
        {
          "name": "List Complaints",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/complaints?per_page=20",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "complaints"
              ],
              "query": [
                {
                  "key": "per_page",
                  "value": "20"
                }
              ]
            },
            "description": "Paginated: `meta` carries total, page, per_page. Filter with status=pending|in_progress|resolved|rejected, location_id, client_id, assigned_employee_id. per_page is 1-100. The response never contains internal_notes or internal_cost."
          }
        },
        {
          "name": "List Complaints (Filter by Status)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/complaints?status=pending",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "complaints"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "pending"
                }
              ]
            },
            "description": "Same endpoint with the status filter the complaint tabs send."
          }
        },
        {
          "name": "Get Complaint Detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/complaints/{{complaint_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "complaints",
                "{{complaint_id}}"
              ]
            }
          }
        },
        {
          "name": "Reopen Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Kunde meldet, dass die Fenster nicht ordentlich gereinigt wurden. Nacharbeit erforderlich.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/orders/{{order_id}}/reopen",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "orders",
                "{{order_id}}",
                "reopen"
