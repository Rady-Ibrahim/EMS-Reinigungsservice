            "body": {
              "mode": "raw",
              "raw": "{\n  \"location_id\": {{location_id}},\n  \"title\": \"Fensterscheibe gesprungen\",\n  \"description\": \"Beim Putzen ist die untere Scheibe des Bürofensters gesprungen.\",\n  \"photos\": [\"uploads/schaden-1.jpg\"]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
